      "injection": "DROP_RESPONSE",
      "expectedProviderCalls": "1",
      "expectedState": "RECOVERY_NEEDED; no automatic second provider request",
      "recovery": "manual_provider_reconciliation",
      "gate": "G-06",
      "p0": true,
      "proof": [
        "sqlite_snapshot",
