    {
      "id": "F14_BACKUP_RESTORE_AGENT_STATE",
      "cutPoint": "backup_after_claim_before_restore",
      "injection": "RESTORE",
      "expectedProviderCalls": "0..1",
      "expectedState": "agent grants, publication intents, claims, events and media survive consistent restore",
      "recovery": "restore_with_evidence",
      "gate": "G-10",
      "p0": true,
      "proof": [
        "sqlite_snapshot",
        "activity_events",
        "fake_provider_request_log",
        "canonical_media_checksums",
        "no_new_unapproved_send_after_restart"
      ],
      "assertNoBlindRetry": true
