      "expectedProviderCalls": "0..policy_limit",
      "expectedState": "atomic limit per target and IANA day, no bypass by two agents",
      "recovery": "quota_guard",
      "gate": "G-05",
      "p0": true,
      "proof": [
        "sqlite_snapshot",
        "activity_events",
        "fake_provider_request_log",
