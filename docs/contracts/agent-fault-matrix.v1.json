{
  "contractId": "publikator.agent-fault-matrix",
  "schemaVersion": 1,
  "status": "DESIGN_NOT_IMPLEMENTED",
  "harness": "isolated node process + tmp SQLite & volume + fake VK/TG/MAX adapters; outbound external network denied",
  "failpointRules": {
    "eachScenarioRequiresDeterministicCut": true,
    "replayUsesSameIdempotencyKey": true,
    "unknownOutcomeNeverAutomaticallyResends": true,
    "neverUseRealProviderCredentialsInCI": true,
    "comparePostAndTargetRevisionDigests": true,
    "requiresBackupRestore": true
  },
  "scenarios": [
    {
      "id": "F01_BEFORE_OPERATION_RECEIPT",
      "cutPoint": "before_receipt_commit",
      "injection": "SIGKILL",
      "expectedProviderCalls": "0",
      "expectedState": "not_started",
      "recovery": "retry permitted as first commit; no phantom job",
      "gate": "G-06",
      "p0": true,
      "proof": [
        "sqlite_snapshot",
        "activity_events",
        "fake_provider_request_log",
        "canonical_media_checksums",
        "no_new_unapproved_send_after_restart"
      ],
      "assertNoBlindRetry": true
    },
    {
      "id": "F02_AFTER_OPERATION_RECEIPT",
      "cutPoint": "after_receipt_commit_before_202",
      "injection": "SIGKILL",
      "expectedProviderCalls": "0",
      "expectedState": "same durable jobId after recovery, no duplicate row",
      "recovery": "idempotent_replay",
      "gate": "G-06",
      "p0": true,
      "proof": [
        "sqlite_snapshot",
        "activity_events",
        "fake_provider_request_log",
        "canonical_media_checksums",
        "no_new_unapproved_send_after_restart"
      ],
      "assertNoBlindRetry": true
    },
    {
      "id": "F03_DURING_MEDIA_WRITE",
      "cutPoint": "during_media_persist_hash",
      "injection": "SIGKILL",
      "expectedProviderCalls": "0",
      "expectedState": "tracked partial object cleaned/reused; ordered canonical media IDs unchanged",
      "recovery": "media_reconcile",
      "gate": "G-07",
      "p0": true,
      "proof": [
        "sqlite_snapshot",
        "activity_events",
        "fake_provider_request_log",
        "canonical_media_checksums",
        "no_new_unapproved_send_after_restart"
      ],
      "assertNoBlindRetry": true
    },
    {
      "id": "F04_AFTER_OWNER_APPROVAL",
      "cutPoint": "after_exact_approval_commit",
      "injection": "SIGKILL",
      "expectedProviderCalls": "0",
      "expectedState": "approval digest+intent/audit persistent, not self-approved by agent",
      "recovery": "resume_only_after_policy_check",
      "gate": "G-04",
      "p0": true,
      "proof": [
        "sqlite_snapshot",
        "activity_events",
        "fake_provider_request_log",
        "canonical_media_checksums",
        "no_new_unapproved_send_after_restart"
      ],
      "assertNoBlindRetry": true
    },
    {
      "id": "F05_AFTER_SCHEDULER_SELECTION",
      "cutPoint": "after_due_selected_before_target_claim",
      "injection": "SIGKILL",
      "expectedProviderCalls": "0",
      "expectedState": "scheduled intent remains pending, new claim requires reauthorization",
      "recovery": "safe_reselect",
      "gate": "G-05",
      "p0": true,
      "proof": [
        "sqlite_snapshot",
        "activity_events",
        "fake_provider_request_log",
        "canonical_media_checksums",
        "no_new_unapproved_send_after_restart"
      ],
      "assertNoBlindRetry": true
    },
