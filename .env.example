PORT=8080
HOST=0.0.0.0
DATA_DIR=/app/data
PUBLIC_BASE_URL=https://publisher.example.ru
# Docker host bind. Keep 127.0.0.1 behind nginx/Caddy; set 0.0.0.0 only deliberately.
PUBLIKATOR_BIND=127.0.0.1
PUBLIKATOR_PORT=8080
# Named volume by default. Advanced users may set ./data, but must manage host permissions themselves on Linux.
PUBLIKATOR_DATA_SOURCE=publikator-data
# Comma-separated trusted reverse-proxy IP/CIDR names, e.g. loopback,172.16.0.0/12. Leave empty without a proxy.
TRUST_PROXY=
# Public example placeholders below are intentionally rejected at startup. Replace them before deployment.
ADMIN_PASSWORD=change-this-password
APP_MASTER_KEY=change-this-to-a-long-random-secret-at-least-32-characters
SESSION_TTL_HOURS=24
SCHEDULER_INTERVAL_MS=15000
QUEUE_SLOT_GRACE_MINUTES=60
EVENT_RETENTION_DAYS=180
BACKUP_RETENTION_COUNT=30
# Canonical media limits. Video v1 accepts MP4/H.264 with AAC or no audio.
MAX_IMAGE_BYTES=52428800
MAX_VIDEO_BYTES=536870912
MEDIA_PROCESSING_TIMEOUT_MS=120000
# Must be >= MAX_VIDEO_BYTES + MAX_IMAGE_BYTES. Covers one bounded in-process video preparation reservation.
MEDIA_TEMP_BUDGET_BYTES=1073741824
# Optional executable overrides for tests/custom images. Production Docker contains ffmpeg/ffprobe.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# For a release build set this to the exact output of: git rev-parse HEAD
BUILD_SHA=
RELEASE_TARGET_VERSION=1.0.0
