    "fastify": "^5.0.0",
    "sharp": "^0.34.0",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
